{
    "manifest_version": 3,
    "name": "ꜱʟᴏᴡ & ʀᴇᴠᴇʀʙ",
    "version": "1.0",
    "description": "Slows and Reverbs Yt Videos",
    "action": {
        "default_popup": "index.html"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.youtube.com/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ],
    "permissions": [
        "activeTab",
        "storage"
    ]
}