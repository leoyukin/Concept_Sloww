{
    "manifest_version": 3,
    "name": "ꜱʟᴏᴡ & ʀᴇᴠᴇʀʙ",
    "version": "1.0",
    "description": "Slows and Reverbs Yt Videos",
    "action": {
        "default_popup": "index.html"
    },
    "icons": {
        "16": "Images/favicon-96x96.png",
        "48": "Images/favicon-96x96.png",
        "128": "Images/favicon-96x96.png"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.youtube.com/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ],
    "permissions": [
        "activeTab",
        "storage"
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "slow-reverb-yt@yourdomain.com",
            "strict_min_version": "109.0"
        }
    }
}